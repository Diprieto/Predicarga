<<setup, include=FALSE>>=
library(knitr)
opts_chunk$set(echo = FALSE, message = FALSE, warning = FALSE, comment = "",
               fig.align = "center", fig.width = 5, fig.height = 4.2,
               out.width = "0.6\\linewidth")
options(OutDec = ",", digits = 4)
@

<<modelo, include=FALSE, error=FALSE>>=
# =========================================================================
#  O MODELO -- troque somente este bloco
# =========================================================================
# 1. O banco, ja limpo pelo codigo do grupo:
dados <- droplevels(as.data.frame(readRDS("Corpus/exportacao_cargas_1trimestre_2017_2026.rds")))

# 2. A resposta Y e as colunas que NAO entram no modelo:
if (!is.numeric(dados$ANO_MES)) {
  dados$ANO_MES <- as.numeric(gsub("-", "", as.character(dados$ANO_MES)))
}

if (!is.numeric(dados$TOTAL_TONELADAS)) {
  x_ton <- as.character(dados$TOTAL_TONELADAS)
  if (any(grepl(",", x_ton, fixed = TRUE))) {
    x_ton <- gsub("\\.", "", x_ton)
    x_ton <- gsub(",", ".", x_ton, fixed = TRUE)
  }
  dados$TOTAL_TONELADAS <- as.numeric(x_ton)
}

resposta <- "TOTAL_TONELADAS"
fora <- c(
  "TOTAL_TEU", "NUMERO_VIAGEM", "MOVIMENTO", "ANO", "TERMINAIS",
  "TOTAL_UNID", "MES", "CLASSENAVIO", "SENTIDO", "TIPO_INSTALACAO",
  "BERCOS", "MERCADORIAS"
)

# 3. O modelo escolhido (Random Forest):
ajusta <- function(d) {
  set.seed(1)
  if (nrow(d) > 100000) {
    d <- d[sample(nrow(d), 100000), ]
  }
  randomForest::randomForest(
    TOTAL_TONELADAS ~ .,
    data = d,
    mtry = 2,
    ntree = 100,
    maxnodes = 64
  )
}
# =========================================================================
@

<<calculos, include=FALSE, error=FALSE>>=
# ---- daqui para baixo, nada precisa ser trocado -------------------------
tex <- function(x) {                       # texto vindo dos dados -> LaTeX
  x <- gsub("\\\\", "\001", as.character(x))
  x <- gsub("([&%$#_{}])", "\\\\\\1", x)
  x <- gsub("~", "\\\\textasciitilde{}", x)
  x <- gsub("\\^", "\\\\textasciicircum{}", x)
  gsub("\001", "\\\\textbackslash{}", x)
}

# --- o banco do modelo -----------------------------------------------------
if (!resposta %in% names(dados))
  stop("A coluna '", resposta, "' nao esta no banco. Confira 'resposta' no bloco modelo.")
fora_errada  <- setdiff(fora, names(dados))
fora         <- intersect(fora, names(dados))
usa_exemplo  <- identical(dados, iris)
quantitativa <- is.numeric(dados[[resposta]]) && length(unique(na.omit(dados[[resposta]]))) > 2
dm <- dados[, setdiff(names(dados), fora), drop = FALSE]
dm[] <- lapply(dm, function(v) if (is.character(v) || is.logical(v)) factor(v) else v)
if (!quantitativa) dm[[resposta]] <- factor(dm[[resposta]])
dm <- na.omit(dm)

# --- o modelo no banco inteiro ---------------------------------------------
falha  <- NULL
modelo <- tryCatch(ajusta(dm), error = function(e) { falha <<- conditionMessage(e); NULL })

# --- o relatorio do modelo (item 4 do bloco modelo) ------------------------
relatorio <- function(m) {
  op <- options(OutDec = ".", width = 80)   # o relatorio sai como no console do R
  on.exit(options(op))
  if (is.null(m)) {
    cat("O modelo nao rodou: veja o aviso no topo da primeira pagina.\n")
  } else if (inherits(m, "randomForest")) {
    print(m)
    cat("Importancia dos preditores:\n"); print(round(randomForest::importance(m), 3))
  } else if (inherits(m, "rpart")) {
    print(m, digits = 3)
  } else if (inherits(m, "cv.glmnet")) {
    cat("lambda escolhido pela validacao cruzada:", signif(m$lambda.min, 3), "\n\n")
    print(coef(m, s = "lambda.min"))
  } else print(summary(m))
}

# --- os avisos do topo da primeira pagina ----------------------------------
avisos <- paste(c(
  if (usa_exemplo) "\\aviso{o bloco \\texttt{modelo} ainda usa o exemplo (\\texttt{iris}).}",
  if (!is.null(falha)) paste0("\\aviso{o modelo n\\~ao rodou. Mensagem do R: \\texttt{", tex(falha), "}}"),
  if (length(fora_errada) > 0) paste0("\\aviso{em \\texttt{fora} h\\'a colunas que n\\~ao est\\~ao no banco: ",
                                     paste0("\\texttt{", tex(fora_errada), "}", collapse = ", "), ".}")),
  collapse = "\n")
@

